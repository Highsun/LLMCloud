                  "type": "string",
                  "format": "uuid"
                }
              },
              "Location": {
                "description": "Dataset detail URL",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_MULTIPART",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
