            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR or INVALID_DATASET",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
