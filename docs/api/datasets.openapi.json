            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STORAGE_UNAVAILABLE or DATABASE_UNAVAILABLE",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/DatasetUpload"
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "datasets"
        ],
        "summary": "List datasets ordered by created_at DESC, id DESC",
        "description": "Reject unknown and duplicate query parameters. Beyond-last pages return 200 with empty items.",
        "operationId": "list_datasets",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetPage"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STORAGE_UNAVAILABLE or DATABASE_UNAVAILABLE",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ]
      }
    },
    "/datasets/{dataset_id}": {
      "get": {
        "tags": [
          "datasets"
        ],
        "summary": "Get metadata without reading the raw training file",
        "operationId": "get_dataset",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Dataset Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetDetail"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "404": {
            "description": "DATASET_NOT_FOUND",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STORAGE_UNAVAILABLE or DATABASE_UNAVAILABLE",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID; matches error.request_id",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ApiErrorCode"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Details"
          },
          "details_truncated": {
            "type": "boolean",
            "title": "Details Truncated"
          },
          "request_id": {
            "type": "string",
            "format": "uuid4",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "details",
          "details_truncated",
          "request_id"
        ],
        "title": "ApiError"
      },
      "ApiErrorCode": {
        "type": "string",
        "enum": [
          "INVALID_MULTIPART",
          "UNSUPPORTED_MEDIA_TYPE",
          "UPLOAD_TOO_LARGE",
          "VALIDATION_ERROR",
          "INVALID_DATASET",
          "DATASET_NOT_FOUND",
          "TASK_NOT_FOUND",
          "IDEMPOTENCY_CONFLICT",
          "REQUEST_TOO_LARGE",
          "DISPATCH_FAILED",
          "DISPATCH_UNCERTAIN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "STORAGE_UNAVAILABLE",
          "DATABASE_UNAVAILABLE",
          "INTERNAL_ERROR",
          "HTTP_ERROR"
        ],
        "title": "ApiErrorCode"
      },
      "DatasetDetail": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid4",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "format": {
            "type": "string",
            "const": "alpaca_jsonl",
            "title": "Format"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Size Bytes"
          },
          "row_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Row Count"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "original_filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Original Filename"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "format",
          "size_bytes",
          "row_count",
          "created_at",
          "original_filename",
          "sha256"
        ],
        "title": "DatasetDetail"
      },
      "DatasetPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DatasetSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Page Size"
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Pages"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "total_pages"
        ],
        "title": "DatasetPage"
      },
      "DatasetSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid4",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "format": {
            "type": "string",
            "const": "alpaca_jsonl",
            "title": "Format"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Size Bytes"
          },
          "row_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Row Count"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "format",
          "size_bytes",
          "row_count",
          "created_at"
        ],
        "title": "DatasetSummary"
      },
      "DatasetUpload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "x-max-bytes": 52428800,
            "description": "UTF-8 .jsonl file, instruction/input/output records",
            "x-record-schema": {
              "$ref": "#/components/schemas/InstructionRecord"
            }
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string",
            "description": "Optional display name; omission uses sanitized filename",
            "x-max-bytes": 1024
          }
        },
        "x-max-body-bytes": 52494336,
        "x-max-line-bytes": 1048576,
        "x-parser-max-files": 4,
        "x-parser-max-fields": 4,
        "x-parser-max-text-part-bytes": 65536,
        "x-duplicate-parts": "rejected"
      },
      "ErrorDetail": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "minItems": 1,
            "title": "Loc"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "title": "Code"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "column": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Column"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "loc",
          "code",
          "message",
          "line",
          "column"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "InstructionRecord": {
        "additionalProperties": false,
        "properties": {
          "instruction": {
            "title": "Instruction",
            "type": "string"
          },
          "input": {
            "default": "",
            "title": "Input",
            "type": "string"
          },
          "output": {
            "title": "Output",
            "type": "string"
          }
        },
        "required": [
          "instruction",
          "output"
        ],
        "title": "InstructionRecord",
        "type": "object"
      }
    }
  }
}
