      "enum": [
        "INVALID_MULTIPART",
        "UNSUPPORTED_MEDIA_TYPE",
        "UPLOAD_TOO_LARGE",
        "VALIDATION_ERROR",
        "INVALID_DATASET",
        "DATASET_NOT_FOUND",
        "TASK_NOT_FOUND",
        "IDEMPOTENCY_CONFLICT",
        "REQUEST_TOO_LARGE",
        "DISPATCH_FAILED",
        "DISPATCH_UNCERTAIN",
        "NOT_FOUND",
        "METHOD_NOT_ALLOWED",
        "STORAGE_UNAVAILABLE",
        "DATABASE_UNAVAILABLE",
        "INTERNAL_ERROR",
        "HTTP_ERROR"
