# Copy outside Git to E:/LLMCloud/private/compose.env (or a cloud persistent disk).
# Linux example: /srv/llmcloud/state ; Windows example: E:/LLMCloud/deployment/state
# WSL must use the ext4 filesystem backed by E:, not /mnt/e, for Linux fd/flock safety.
LLMCLOUD_STATE_DIR=/home/l7/llmcloud-deploy/state
# Existing HF_HOME, containing hub/models--Qwen--Qwen2.5-0.5B-Instruct/...
LLMCLOUD_MODEL_DIR=/home/l7/.cache/huggingface
# Fresh host export containing build-provenance.json; do not reuse after code edits.
LLMCLOUD_PROVENANCE_DIR=/home/l7/llmcloud-deploy/provenance
LLMCLOUD_UID=1000
LLMCLOUD_GID=1000
LLMCLOUD_IMAGE_TAG=local
LLMCLOUD_BIND_IP=127.0.0.1
LLMCLOUD_HTTP_PORT=8080
TRAINING_PRECISION=bf16
AUTH_ENABLED=true
# Set true only when accessing the frontend via HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=43200
CORS_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080"]
