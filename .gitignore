!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# Frontend
node_modules/
*.tsbuildinfo
*.local
npm-debug.log*

# Datasets, weights, training artifacts and logs stay out of Git
data/**
!data/datasets/
!data/models/
!data/outputs/
!data/datasets/.gitkeep
!data/models/.gitkeep
!data/outputs/.gitkeep
logs/**
!logs/.gitkeep
*.db
*.db-*
*.sqlite*
*.log
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
celerybeat-schedule*
