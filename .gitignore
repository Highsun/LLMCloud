# Python / local environments
__pycache__/
*.py[cod]
.venv*/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Local configuration and credentials
.env
.env.*
!.env.example
!frontend/.env.example
.aws/
.codex/
.agents/
.idea/
!.vscode/
