APP_NAME=LLMCloud
APP_ENV=development
API_PREFIX=/api/v1
# Paths below are relative to the repository root, independent of shell cwd.
DATA_DIR=data
LOG_DIR=logs
# Empty uses an absolute SQLite URL under DATA_DIR. PostgreSQL is a later step.
DATABASE_URL=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
TRAINING_QUEUE=gpu
DEFAULT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
HF_HOME=data/models/huggingface
CUDA_VISIBLE_DEVICES=0
