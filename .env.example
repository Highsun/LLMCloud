APP_NAME=LLMCloud
APP_ENV=development
API_PREFIX=/api/v1
# Paths below are relative to the repository root, independent of shell cwd.
DATA_DIR=data
LOG_DIR=logs
# Empty uses an absolute SQLite URL under DATA_DIR. PostgreSQL is a later step.
DATABASE_URL=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
TRAINING_QUEUE=gpu
DEFAULT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
DEFAULT_MODEL_REVISION=7ae557604adf67be50417f59c2c2f167def9a775
TRAINING_PRECISION=bf16
# Internal smoke-test control, not a public task field. Unset trains all epochs.
# TRAINING_MAX_STEPS=2
HF_HOME=data/models/huggingface
CUDA_VISIBLE_DEVICES=0
